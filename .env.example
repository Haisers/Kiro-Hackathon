# Copy to .env.local. Never commit real credentials.
# These integrations are not used by the mock-only Vitality UI.

# Server-only Supabase credentials. Never prefix secret keys with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional AWS configuration for a future server-only integration.
AWS_REGION=
AWS_BEDROCK_MODEL_ID=
AWS_PROFILE=
AWS_SNS_REGION=
AWS_BEDROCK_REGION=
LOCAL_DEMO_AI_ENABLED=false

# Optional SMS configuration for a future server-only integration.
PHILSMS_API_TOKEN=
PHILSMS_SENDER_ID=
SMS_ALLOWED_NUMBERS=
LOCAL_DEMO_SMS_ENABLED=false
